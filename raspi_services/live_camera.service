[Unit]
Description=Libcamera video stream on port tcp://drone.local:2222
After=network.target

[Service]
Type=simple
User=drone
# --inline + --intra 25: SPS/PPS and a keyframe every second, so viewers can join quickly
# --flush: send each frame immediately; -n: no preview window
ExecStart=/bin/sh -lc 'exec rpicam-vid -t 0 -n --inline --intra 25 --flush --shutter 5000 --framerate 25 --width 720 --height 720 -o - | nc -lk -p 2222'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target